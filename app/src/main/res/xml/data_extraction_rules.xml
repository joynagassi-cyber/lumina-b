<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Les sauvegardes/restaurations système ne doivent pas migrer les comptes,
         PIN ni données financières. Utiliser les archives Lumina explicites. -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
