<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Never copy Supabase refresh credentials to a different device. -->
        <exclude domain="sharedpref" path="lumina_cloud_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lumina_cloud_session.xml" />
    </device-transfer>
</data-extraction-rules>
